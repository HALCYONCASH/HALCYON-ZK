{
  "name": "halcyon",
  "version": "0.9.1",
  "private": true,
  "description": "Halcyon: the calm Ethereum launchpad. A coin and its locked Uniswap pool in one transaction; every trade pays 1% to the pool, 80% of it to the module the creator chose, 20% to the platform; the gardener pays the rest.",
  "license": "MIT",
  "homepage": "https://halcyon.cash",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HALCYONCASH/HALCYON-ZK.git"
  },
  "bugs": {
    "url": "https://github.com/HALCYONCASH/HALCYON-ZK/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server.mjs",
    "start:demo": "node server.mjs --demo",
    "contracts:compile": "node contracts/compile.mjs",
    "test:contracts": "node tests/contracts.test.mjs",
    "test:modules": "node tests/modules.test.mjs",
    "check": "tsc -b --pretty false && node --check server.mjs && node tests/contracts.test.mjs && node tests/modules.test.mjs && node tests/deploy.test.mjs && node tests/ui.test.mjs",
    "test:deploy": "node tests/deploy.test.mjs",
    "deploy": "node scripts/deploy.mjs",
    "verify": "node scripts/verify.mjs",
    "admin": "node scripts/admin.mjs",
    "stocks": "node scripts/stocks.mjs",
    "test:ui": "node tests/ui.test.mjs",
    "publish-check": "node scripts/publish-check.mjs"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "lightweight-charts": "^5.2.1",
    "poseidon-lite": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "snarkjs": "^0.7.6",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@uniswap/swap-router-contracts": "^1.3.1",
    "@uniswap/v2-core": "^1.0.1",
    "@uniswap/v2-periphery": "^1.1.0-beta.0",
    "@uniswap/v3-core": "^1.0.1",
    "@uniswap/v3-periphery": "^1.4.4",
    "@uniswap/v4-core": "^1.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "circom2": "^0.2.23",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "hardhat": "^2.29.1",
    "playwright-core": "^1.63.0",
    "solc": "^0.8.28",
    "solc0826": "npm:solc@^0.8.26",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
